{
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4.1-flash",
    "base_url": "https://opencode.ai/inference/go/openai/v1",
    "api_key_env": "OPENCODE_API_KEY",
    "extra_headers": {
      "x-opencode-session": "horizon-news-1",
      "User-Agent": "horizon-news/1.0"
    },
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "ai-practice": {
        "threshold": 3.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": false
      }
    }
  },
  "sources": {
