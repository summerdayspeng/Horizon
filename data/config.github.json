  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "ai-practice",
      "finance-news",
      "tech-blog"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "SERVERCHAN_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "title": "#{message_title}",
      "desp": "#{summary?limit=9000&split=---}\n\n---\n\n> 篇幅所限，微信版已截断。完整日报见 https://summerdayspeng.github.io/Horizon/"
    },
    "body_format": "form",
    "headers": ""
  }
